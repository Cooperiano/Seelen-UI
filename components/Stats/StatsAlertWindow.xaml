<Window x:Class="MenuBar.StatsAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#FFF5F5F7">
    <Border Background="#FA202024" BorderBrush="#55FF8DA1" BorderThickness="1" CornerRadius="12" Padding="14">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.45" /></Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Background="#FFFF8DA1" CornerRadius="3" />
            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" Margin="0,4,0,0" Foreground="#FFB6B6BE" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="×" Width="24" Height="24" Foreground="#FFA9A9B0" Background="Transparent" BorderThickness="0" FontSize="16" Click="Close_Click" />
        </Grid>
    </Border>
</Window>
