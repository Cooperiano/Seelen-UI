<Application x:Class="MenuBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="BarBrush" Color="#F21D1D20" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF5F5F7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFA9A9B0" />
        <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="PressedBrush" Color="#35FFFFFF" />
        <SolidColorBrush x:Key="CpuBrush" Color="#FF65D5FF" />
        <SolidColorBrush x:Key="GpuBrush" Color="#FF72E6AE" />
        <SolidColorBrush x:Key="MemoryBrush" Color="#FFFFC568" />
        <SolidColorBrush x:Key="SensorBrush" Color="#FFFF8DA1" />

        <Style x:Key="StatusButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#88FFFFFF" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricButton" TargetType="Button" BasedOn="{StaticResource StatusButton}">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
    </Application.Resources>
</Application>
