<Window x:Class="MenuBar.StatsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stats 设置" Width="860" Height="650" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#FFF5F6F8" Foreground="#FF202124"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#FF68717D" />
        <SolidColorBrush x:Key="Divider" Color="#FFE2E5E9" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#FF0A84FF" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FF30343A" />
            <Setter Property="Background" Value="#FFF0F2F5" />
            <Setter Property="BorderBrush" Value="#FFDDE1E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FFE5E9EE" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" /><Setter Property="Padding" Value="18,7" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF52606D" /><Setter Property="Padding" Value="8,5" />
        </Style>
        <Style x:Key="RoundIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" /><Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF25282D" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="34" Height="18" CornerRadius="9" Background="#FFC8CDD4" HorizontalAlignment="Left">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.22" /></Ellipse.Effect>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FF202124" /><Setter Property="Background" Value="#FFF5F6F8" />
            <Setter Property="BorderBrush" Value="#FFD7DBE0" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" /><Setter Property="CaretBrush" Value="#FF202124" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#FF626B76" />
            <Setter Property="Margin" Value="4,0,0,7" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SectionSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" /><Setter Property="BorderBrush" Value="{StaticResource Divider}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" /></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="4" Margin="2,1">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#FFB6BCC4" CornerRadius="2" /></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="188" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Background="#FFEEF0F3" BorderBrush="#FFD9DDE2" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,13,10,10">
                <StackPanel DockPanel.Dock="Top" Margin="9,4,9,12">
                    <TextBlock Text="Stats" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="系统监控" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,1,0,0" />
                </StackPanel>
                <Grid DockPanel.Dock="Bottom" Height="38" Margin="2,8,2,0">
                    <TextBlock Text="独立采集 · Seelen 共享" FontSize="9" Foreground="#FF818892" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
                <ListBox x:Name="ModuleList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ModuleList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#FF3F444B" /><Setter Property="Padding" Value="9,0" />
                            <Setter Property="Height" Value="34" /><Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Nav" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#FFDDE1E6" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#FFD6E7FA" /><Setter Property="Foreground" Value="#FF155E9F" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Grid Margin="28,21,28,0">
                <StackPanel>
                    <TextBlock x:Name="ModuleTitle" Text="菜单栏" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="ModuleDescription" Margin="0,3,0,0" Foreground="{StaticResource Muted}" FontSize="11" />
                </StackPanel>
                <Button x:Name="RestoreDefaultsButton" Content="恢复默认" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="RestoreDefaults_Click" />
            </Grid>

            <Border x:Name="MonitoringPreview" Grid.Row="1" Style="{StaticResource SectionSurface}" Margin="28,15,28,14" Padding="13,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="菜单栏" FontSize="10" Foreground="#FF7A828C" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <ItemsControl x:Name="PreviewItems" Grid.Column="1">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,11,0">
                                <TextBlock Text="{Binding Title}" FontSize="9" Foreground="{Binding Accent}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Sample}" Margin="3,0,0,0" FontSize="9" Foreground="#FF2D3035" />
                            </StackPanel></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EnabledSummary" Grid.Column="2" FontSize="9" Foreground="#FF858C95" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,20,0">
                <StackPanel Margin="0,0,8,18">
                    <StackPanel x:Name="SuitePanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="桌面工具" />
                        <Border Style="{StaticResource SectionSurface}" Padding="14,2">
                            <StackPanel>
                                <Grid Margin="0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Seelen · 桌面套件" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="主程序统一管理启动、退出、自启与组件开关。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock x:Name="MenuBarAvailability" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="OpenMenuBarButton" Content="打开套件设置" Click="OpenMenuBar_Click" AutomationProperties.Name="打开 Seelen 套件设置"/><Button Content="设置显示项" Click="OpenDisplayItems_Click" Style="{StaticResource QuietButton}" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                                <Border Height="1" Background="{StaticResource Divider}"/>
                                <Grid Margin="0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Stats · 系统监控" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="统一管理指标、采样、历史与通知。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
                                    <Button Grid.Column="1" Content="配置监控" Click="OpenMonitoring_Click" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{StaticResource Divider}"/>
                                <Grid Margin="0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Touchpad Control · 触控板" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="指针速度、加速度与三指拖拽；输入引擎独立运行。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock x:Name="TouchpadAvailability" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                                    <Button x:Name="OpenTouchpadButton" Grid.Column="1" Content="在套件中管理" Click="OpenTouchpad_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Stats 是可选监控组件。组件开关与整个套件的退出、自启统一在 Seelen 设置中管理；关闭 Stats 后，顶栏监控区域留空，配置仍保留。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="4,12,4,0"/>
                        <TextBlock x:Name="SuiteActionStatus" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="4,10,4,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <StackPanel x:Name="OverviewPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="此电脑" />
                        <Border Style="{StaticResource SectionSurface}" Padding="16,13" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="10" Background="#FFE6F0FB" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="#FF2474B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ComputerNameText" Text="正在读取此电脑" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ComputerModelText" Text="Windows 电脑" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="ComputerOsText" FontSize="9" Foreground="#FF858C95" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="电脑信息" />
                        <Border Style="{StaticResource SectionSurface}" Padding="14,2" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="处理器" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="ComputerProcessorText" Grid.Column="1" Text="正在读取" FontSize="10" TextAlignment="Right" TextTrimming="CharacterEllipsis"/></Grid>
                                <Border Height="1" Background="{StaticResource Divider}"/>
                                <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="内存" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="ComputerMemoryText" Grid.Column="1" Text="正在读取" FontSize="10" TextAlignment="Right"/></Grid>
                                <Border Height="1" Background="{StaticResource Divider}"/>
                                <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="图形设备" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="ComputerGraphicsText" Grid.Column="1" Text="正在读取" FontSize="10" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/></Grid>
                                <Border Height="1" Background="{StaticResource Divider}"/>
                                <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="运行时间" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="ComputerUptimeText" Grid.Column="1" Text="正在读取" FontSize="10" TextAlignment="Right"/></Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="运行状态" />
                        <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16">
                            <UniformGrid Columns="4">
                                <StackPanel Margin="14,12"><TextBlock Text="显示组件" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="OverviewEnabledText" Text="--" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Margin="14,12"><TextBlock Text="刷新频率" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="OverviewRefreshText" Text="--" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Margin="14,12"><TextBlock Text="历史窗口" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="OverviewHistoryText" Text="--" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Margin="14,12"><TextBlock Text="采集策略" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="OverviewPowerText" Text="--" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                            </UniformGrid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="快速配置" />
                        <Border Style="{StaticResource SectionSurface}" Padding="14,11" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="常用组合" FontSize="12"/><TextBlock Text="保留颜色、样式和顺序" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="极简" Click="MinimalProfile_Click" Margin="0,0,5,0"/>
                                    <Button Content="均衡" Click="BalancedProfile_Click" Margin="0,0,5,0" Background="#FFDDEBFA" BorderBrush="#FFC5DCF4" Foreground="#FF155E9F"/>
                                    <Button Content="传感器" Click="SensorProfile_Click" Margin="0,0,5,0"/>
                                    <Button Content="全部隐藏" Click="DisableAll_Click" Foreground="#FFB13B45"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="模块状态" />
                        <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16" Padding="4,3">
                            <ItemsControl x:Name="OverviewItems">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="11,9">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" Fill="{Binding Accent}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,12,0"><TextBlock Text="{Binding Title}" FontSize="11"/><TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0"/></StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Sample}" Foreground="{Binding Accent}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="9" HorizontalAlignment="Right" Margin="0,2,0,0"/></StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="MetricsSectionLabel" Style="{StaticResource SectionLabel}" Text="菜单栏组件" />
                    <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16" Padding="3">
                        <ItemsControl x:Name="MetricsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="11,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="36"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="MetricToggle_Click">
                                                <StackPanel Margin="6,0,0,0"><TextBlock Text="{Binding Title}" FontSize="11"/><TextBlock Text="{Binding Description}" Margin="0,2,0,0" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel>
                                            </CheckBox>
                                            <Button Grid.Column="1" Margin="8,0,5,0" Content="{Binding DisplayStyleLabel}" Tag="{Binding Id}" Click="DisplayStyle_Click" ToolTip="切换菜单栏显示样式"/>
                                            <Button Grid.Column="2" Content="●" Foreground="{Binding Accent}" Margin="0,0,3,0" Padding="0" ToolTip="切换指标颜色" Click="Color_Click" AutomationProperties.Name="切换指标颜色"/>
                                            <Button Grid.Column="3" Content="&#xE72B;" Style="{StaticResource RoundIconButton}" Tag="{Binding Id}" ToolTip="向左移动" Click="MoveUp_Click"/>
                                            <Button Grid.Column="4" Content="&#xE72A;" Style="{StaticResource RoundIconButton}" Tag="{Binding Id}" ToolTip="向右移动" Click="MoveDown_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel x:Name="AlertsPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="资源警报" />
                        <Border Style="{StaticResource SectionSurface}" Padding="3">
                            <ItemsControl x:Name="AlertsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="11,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="58"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="62"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding Title}" Click="AlertSetting_Changed"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ComparisonLabel}" Margin="10,0,6,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="2" Text="{Binding Threshold, Mode=TwoWay}" LostFocus="AlertSetting_Changed"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Unit}" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="4" Text="{Binding SustainSeconds, Mode=TwoWay}" LostFocus="AlertSetting_Changed"/>
                                                <TextBlock Grid.Column="5" Text="秒" Margin="4,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Grid Margin="4,7,2,0"><TextBlock Text="警报触发后冷却 15 分钟" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/><Button Content="测试通知" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Click="TestAlert_Click"/></Grid>
                    </StackPanel>

                    <TextBlock x:Name="CollectionSectionLabel" Style="{StaticResource SectionLabel}" Text="采集与历史" Margin="4,4,0,7" />
                    <Border x:Name="CollectionPanel" Style="{StaticResource SectionSurface}" Padding="14,4">
                        <StackPanel>
                            <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="刷新频率" FontSize="11"/><TextBlock Text="菜单栏与共享数据的采样周期" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel><Button x:Name="RefreshIntervalButton" Grid.Column="1" Click="RefreshIntervalButton_Click"/></Grid>
                            <Border Height="1" Background="{StaticResource Divider}"/>
                            <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="历史窗口" FontSize="11"/><TextBlock Text="详情图表保留的采样时长" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel><Button x:Name="HistoryButton" Grid.Column="1" Click="HistoryButton_Click"/></Grid>
                            <Border Height="1" Background="{StaticResource Divider}"/>
                            <CheckBox x:Name="LowPowerModeCheck" Content="低功耗模式（隐藏的扩展传感器不采集）" Margin="0,10" Click="LowPowerModeCheck_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#FAFFFFFF" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="28,10">
                <Grid>
                    <TextBlock x:Name="SaveHint" Text="更改立即生效，无需重启" Foreground="#FF31835C" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,205,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="退出 Stats" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Foreground="#FFB13B45" Click="ExitStats_Click"/>
                        <Button Content="完成" Style="{StaticResource PrimaryButton}" MinWidth="78" IsDefault="True" Click="Done_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
